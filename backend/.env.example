APP_NAME="Eversoft CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8080

# Default timezone for NEW organizations. The database and app clock stay UTC (see docs/ATTENDANCE.md).
APP_TIMEZONE=Asia/Tashkent

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Tenants can be addressed as {slug}.TENANT_BASE_DOMAIN; the host must match the signed-in user's organization.
TENANT_BASE_DOMAIN=crm.eversoft.uz
TENANT_CENTRAL_DOMAINS=localhost,127.0.0.1,crm.eversoft.uz

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Development credentials. Production must use a dedicated DB user and a strong secret.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=eversoft_crm
DB_USERNAME=root
DB_PASSWORD=root

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
BROADCAST_CONNECTION=log

FILESYSTEM_DISK=local
# Attachments disk: "local" now, "s3" for any S3-compatible storage later (configure AWS_* below).
DOCUMENTS_DISK=local

# Bearer tokens: default lifetime in hours when "keep me signed in" is off.
SANCTUM_SESSION_HOURS=12

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@eversoft.uz"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# Attendance / Hikvision
ATTENDANCE_INITIAL_LOOKBACK_DAYS=2
ATTENDANCE_SYNC_OVERLAP_MINUTES=10
HIKVISION_TIMEOUT=15
HIKVISION_CONNECT_TIMEOUT=5
HIKVISION_RETRIES=2
HIKVISION_PAGE_SIZE=30
HIKVISION_VERIFY_TLS=false

VITE_API_URL=http://localhost:8080/api/v1
