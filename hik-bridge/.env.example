# Terminal on the local network
DEVICE_URL=http://192.168.1.64
DEVICE_USERNAME=admin
DEVICE_PASSWORD=
# UTC offset the terminal clock uses (Asia/Tashkent = +05:00)
DEVICE_TZ_OFFSET=+05:00

# Eversoft CRM and the token from Settings → Attendance devices → Generate bridge token
CRM_URL=https://crm.eversoft.uz
BRIDGE_TOKEN=

POLL_SECONDS=60
INITIAL_LOOKBACK_HOURS=24
PAGE_SIZE=30
STATE_FILE=./state/bridge-state.json
